/* Corporate Lawyer KSA — Design System 2: "Grid & Glass" */
:root{
  --deep:#082625; --deep2:#0F3D3B; --mint:#3FE0C5; --ink:#EAF4F2; --muted:#9CC1BC;
  --paper:#0A2E2E;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'IBM Plex Sans',Arial,sans-serif;background:radial-gradient(1200px 600px at 80% -10%,#124A47,transparent),linear-gradient(180deg,var(--deep),var(--deep2));color:var(--ink);line-height:1.65;min-height:100vh;}
h1,h2,h3,h4{font-family:'Space Grotesk',Arial,sans-serif;font-weight:600;letter-spacing:-.01em;}
a{color:inherit;text-decoration:none;}
img{max-width:100%;display:block;}
.wrap{max-width:1200px;margin:0 auto;padding:0 40px;}
ul{list-style:none;}

/* RTL adjustments */
html[dir="rtl"] body{font-family:'IBM Plex Sans Arabic','Tajawal',Arial,sans-serif;}
html[dir="rtl"] .eyebrow::before{transform:scaleX(-1);}

/* header */
header.site-header{padding:22px 0;border-bottom:1px solid rgba(255,255,255,.08);position:relative;z-index:200;}
header.site-header .nav{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;}
.logo{font-family:'Space Grotesk',Arial,sans-serif;font-weight:700;font-size:19px;white-space:nowrap;display:inline-flex;align-items:center;}
.logo img{height:38px;width:auto;display:block;}
.logo span{color:var(--mint);}
.main-nav ul{display:flex;gap:26px;font-size:13.5px;color:var(--muted);flex-wrap:wrap;}
.main-nav a:hover{color:var(--mint);}
.main-nav li{position:relative;}
.main-nav > ul > li > a{display:flex;align-items:center;gap:5px;padding:8px 0;}
.main-nav > ul > li > a::after{content:"";width:6px;height:6px;border-inline-end:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);margin-top:-4px;opacity:.6;transition:transform .2s;}
.main-nav > ul > li:hover > a::after,.main-nav > ul > li.mega-open > a::after{transform:rotate(225deg);margin-top:2px;}

.mega-panel{
  position:absolute;top:100%;inset-inline-start:50%;transform:translateX(-50%);
  margin-top:14px;min-width:560px;max-width:720px;
  background:linear-gradient(160deg,#0C332F,#082625);
  border:1px solid rgba(255,255,255,.12);border-radius:16px;
  box-shadow:0 24px 60px rgba(0,0,0,.5);
  padding:26px;display:none;gap:28px;z-index:150;
}
html[dir="rtl"] .mega-panel{transform:translateX(50%);}
.main-nav li:hover .mega-panel,.main-nav li.mega-open .mega-panel{display:flex;}
.mega-col{flex:1;min-width:150px;}
.mega-col h5{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--mint);margin-bottom:12px;font-weight:700;}
.mega-col ul{display:flex;flex-direction:column;gap:9px;font-size:13.5px;}
.mega-col a{color:var(--ink);}
.mega-col a:hover{color:var(--mint);}
.mega-viewall{display:inline-block;margin-top:14px;font-size:12.5px;color:var(--mint);font-weight:600;border-top:1px solid rgba(255,255,255,.1);padding-top:12px;width:100%;}
@media(max-width:900px){
  .mega-panel{position:static;transform:none;min-width:0;max-width:none;margin-top:10px;border-radius:12px;flex-wrap:wrap;box-shadow:none;}
  html[dir="rtl"] .mega-panel{transform:none;}
}

/* centered, evenly-spaced content paragraphs used across detail/hub/home pages */
.content-h2{font-size:22px;margin-bottom:14px;text-align:center;}
.content-h2-lg{font-size:24px;margin-bottom:18px;text-align:center;}
.content-p{color:var(--muted);max-width:760px;margin:20px auto;text-align:center;}
.content-p:first-of-type{margin-top:0;}

/* make in-body links clearly visible against the surrounding muted text */
.content-p a,.bullets a,.faq-item p a,.hub-overview a{color:var(--mint);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px;}
.content-p a:hover,.bullets a:hover,.faq-item p a:hover,.hub-overview a:hover{color:#fff;}

.lang-switch{font-size:12.5px;color:var(--muted);border:1px solid rgba(255,255,255,.15);border-radius:100px;padding:6px 12px;}
.header-cta{display:flex;gap:10px;}
.btn{background:var(--mint);color:#052321;padding:12px 22px;border-radius:10px;font-weight:600;font-size:13.5px;display:inline-block;}
.btn-ghost{border:1px solid rgba(255,255,255,.2);padding:11px 20px;border-radius:10px;font-size:13.5px;color:var(--ink);display:inline-block;}
.btn:hover{filter:brightness(1.08);}
.btn-ghost:hover{border-color:var(--mint);color:var(--mint);}

/* breadcrumb */
.breadcrumb{font-size:12.5px;color:var(--muted);padding:20px 0 0;}
.breadcrumb a:hover{color:var(--mint);}
.breadcrumb .sep{margin:0 8px;opacity:.5;}

/* hero (interior pages) */
.page-hero{padding:36px 0 50px;}
.eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(63,224,197,.1);border:1px solid rgba(63,224,197,.3);color:var(--mint);padding:7px 14px;border-radius:100px;font-size:12.5px;margin-bottom:20px;}
.eyebrow::before{content:"";width:16px;height:1px;background:var(--mint);}
.page-hero h1{font-size:38px;line-height:1.15;margin-bottom:18px;max-width:820px;}
.page-hero .lead{color:var(--muted);font-size:16px;max-width:680px;}

/* homepage hero */
.home-hero{padding:60px 0 0;display:grid;grid-template-columns:1fr .9fr;gap:50px;align-items:center;}
.home-hero h1{font-size:48px;line-height:1.12;font-weight:600;margin-bottom:22px;}
.home-hero p.lead{color:var(--muted);font-size:16.5px;max-width:460px;margin-bottom:30px;}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;}
.cta-microcopy{margin-top:12px;font-size:12.5px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.cta-microcopy::before{content:"✓";color:var(--mint);font-weight:700;}

.glass-stack{position:relative;height:400px;border-radius:20px;overflow:hidden;}
.glass-stack-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:20px;}
.glass-stack-bg::after{content:"";}
.glass-stack .bg-overlay{position:absolute;inset:0;background:linear-gradient(160deg,rgba(8,38,37,.55),rgba(8,38,37,.25));border-radius:20px;}
.glass-card{position:absolute;width:260px;padding:20px 22px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(14px);border-radius:16px;box-shadow:0 20px 50px rgba(0,0,0,.35);}
.glass-card h4{font-size:14px;margin-bottom:6px;}
.glass-card p{font-size:12.5px;color:var(--muted);}
.gc1{top:0;left:10px;transform:rotate(-4deg);animation:float1 6s ease-in-out infinite;}
.gc2{top:120px;left:110px;transform:rotate(3deg);animation:float2 7s ease-in-out infinite;}
.gc3{top:250px;left:30px;transform:rotate(-2deg);animation:float1 8s ease-in-out infinite;}
@keyframes float1{50%{transform:translateY(-12px) rotate(-4deg);}}
@keyframes float2{50%{transform:translateY(-16px) rotate(3deg);}}

/* strip */
.strip{border-top:1px solid rgba(255,255,255,.1);border-bottom:1px solid rgba(255,255,255,.1);padding:20px 0;margin-top:30px;}
.strip ul{display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;font-size:12.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;}

/* generic sections */
.section{padding:80px 0;}
.section-head{max-width:640px;margin-bottom:44px;}
.section-head h2{font-size:30px;margin-bottom:12px;}
.section-head p{color:var(--muted);font-size:15px;}

.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
.card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:28px;transition:transform .25s,background .25s;}
.card:hover{transform:translateY(-5px);background:rgba(255,255,255,.08);}
.card .icon{width:38px;height:38px;border-radius:10px;background:rgba(63,224,197,.15);margin-bottom:16px;}
.card h3{font-size:16.5px;margin-bottom:8px;}
.card p{font-size:13.5px;color:var(--muted);}
.card .tag{font-size:11px;font-weight:700;color:var(--mint);text-transform:uppercase;letter-spacing:.04em;margin-bottom:10px;display:block;}

.split{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;}
.img-block{aspect-ratio:16/12;background:rgba(255,255,255,.04);border:1px dashed rgba(255,255,255,.25);border-radius:20px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12.5px;text-align:center;padding:20px;overflow:hidden;}
.img-block img{width:100%;height:100%;object-fit:cover;border-radius:20px;border:none;}

.faq{border-top:1px solid rgba(255,255,255,.1);}
.faq-item{border-bottom:1px solid rgba(255,255,255,.1);padding:20px 0;}
.faq-item h3{font-size:15.5px;margin-bottom:8px;color:var(--ink);}
.faq-item p{font-size:14px;color:var(--muted);}

.bullets{display:grid;gap:10px;margin:20px 0;}
.bullets li{font-size:14.5px;color:var(--ink);padding-inline-start:20px;position:relative;}
.bullets li::before{content:"—";position:absolute;inset-inline-start:0;color:var(--mint);}

.cta-band{background:linear-gradient(120deg,rgba(63,224,197,.14),rgba(63,224,197,.03));border:1px solid rgba(63,224,197,.3);border-radius:24px;padding:56px 50px;text-align:center;margin:0 0 30px;}
.cta-band h2{font-size:26px;margin-bottom:12px;}
.cta-band p{color:var(--muted);margin-bottom:22px;}
.cta-band .btn-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}

.related{display:flex;flex-wrap:wrap;gap:12px;}
.pill{border:1px solid rgba(255,255,255,.15);border-radius:100px;padding:9px 18px;font-size:13px;color:var(--muted);}
.pill:hover{border-color:var(--mint);color:var(--mint);}

footer.site-footer{border-top:1px solid rgba(255,255,255,.1);padding:50px 0 30px;font-size:13px;color:var(--muted);}
footer.site-footer .fgrid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:30px;margin-bottom:30px;}
footer.site-footer h4{color:var(--ink);font-size:13.5px;margin-bottom:12px;}
footer.site-footer li{margin-bottom:8px;}
footer.site-footer li a:hover{color:var(--mint);}
.foot-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:20px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;}

.social-row{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;padding:26px 0;margin-top:6px;border-top:1px solid rgba(255,255,255,.08);}
.social-label{font-size:12.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:600;}
.social-links{display:flex;gap:12px;}
.social-icon{
  width:42px;height:42px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.14);
  color:var(--muted);transition:transform .25s ease,background .25s ease,color .25s ease,border-color .25s ease,box-shadow .25s ease;
}
.social-icon svg{width:19px;height:19px;}
.social-icon:hover{
  background:var(--mint);color:#052321;border-color:var(--mint);
  transform:translateY(-3px);box-shadow:0 8px 20px rgba(63,224,197,.35);
}

.whatsapp-fab{position:fixed;bottom:22px;inset-inline-end:22px;background:var(--mint);color:#052321;width:60px;height:60px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:700;font-size:10.5px;line-height:1.15;box-shadow:0 10px 30px rgba(0,0,0,.45);z-index:60;gap:2px;transition:transform .2s;}
.whatsapp-fab:hover{transform:scale(1.06);}
.whatsapp-fab svg{width:22px;height:22px;}

.mobile-cta-bar{display:none;}

@media(max-width:760px){
  .whatsapp-fab{display:none;}
  .mobile-cta-bar{
    display:flex;position:fixed;left:0;right:0;bottom:0;z-index:70;
    background:rgba(8,38,37,.97);backdrop-filter:blur(10px);
    border-top:1px solid rgba(255,255,255,.12);
    padding:10px 12px calc(10px + env(safe-area-inset-bottom));
    gap:10px;box-shadow:0 -8px 24px rgba(0,0,0,.35);
  }
  .mobile-cta-bar a{
    flex:1;display:flex;align-items:center;justify-content:center;gap:7px;
    padding:13px 10px;border-radius:12px;font-size:14px;font-weight:700;
    text-align:center;white-space:nowrap;
  }
  .mobile-cta-bar .mcta-whatsapp{background:var(--mint);color:#052321;}
  .mobile-cta-bar .mcta-book{background:rgba(255,255,255,.08);color:var(--ink);border:1px solid rgba(255,255,255,.25);}
  .mobile-cta-bar svg{width:18px;height:18px;flex-shrink:0;}
  /* keep page content clear of the fixed bar */
  body{padding-bottom:74px;}
  footer.site-footer{padding-bottom:8px;}
}

.reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease;}
.reveal.in{opacity:1;transform:none;}

@media(max-width:860px){
  .home-hero,.split{grid-template-columns:1fr;}
  .grid3{grid-template-columns:1fr 1fr;}
  footer.site-footer .fgrid{grid-template-columns:1fr 1fr;}
}
@media(max-width:560px){
  .grid3,.grid2,footer.site-footer .fgrid{grid-template-columns:1fr;}
  .wrap{padding:0 20px;}
  .home-hero h1{font-size:34px;}
  .page-hero h1{font-size:28px;}
}
